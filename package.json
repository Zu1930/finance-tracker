{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test lib/*.test.mjs lib/quick-entry/*.test.mjs lib/data/*.test.mjs lib/data/postgres/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-migrate.ts",
    "db:migrate-redis": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server scripts/migrate-redis-to-pg.ts",
    "db:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server scripts/verify-migration.ts",
    "db:migrate-users": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-users-to-auth.ts",
    "reset-password": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/reset-password.ts",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@upstash/redis": "1.39.0",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.3.6",
    "nodemailer": "10.0.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "vercel": "^65.1.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.27.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
