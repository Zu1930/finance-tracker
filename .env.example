# Postgres (Neon). При подключении через Vercel Storage переменные подставятся сами
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Вход (Better Auth): секрет — openssl rand -hex 32; адрес production без / в конце
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Регистрация: invite (по коду или приглашению, по умолчанию) или open; админы — id через запятую
REGISTRATION_MODE=invite
ADMIN_USER_IDS=
# Письма: SMTP (например Gmail: smtp.gmail.com, 465, адрес и пароль приложения) или Resend.
# Ничего не задано — письма пишутся в консоль сервера. Заданы оба — используется SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Отправитель; для SMTP по умолчанию SMTP_USER
MAIL_FROM=
# Cloudflare Turnstile на регистрации и сбросе пароля. Без ключей капчи нет
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — только для скриптов переноса из Redis (db:migrate-redis, db:verify),
# вместе с USERS=vlad:Влад,masha:Маша. Приложение Redis больше не использует
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Push-уведомления (необязательно; без ключей уведомления просто выключены).
# Ключи: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов
VAPID_SUBJECT=mailto:you@example.com
# Секрет ежедневного cron (/api/cron/daily). Vercel передаёт его сам, если задан: openssl rand -hex 32
CRON_SECRET=
# Часовой пояс напоминаний (по умолчанию Europe/Belgrade)
# APP_TZ=Europe/Belgrade
