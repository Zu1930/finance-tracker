# Пользователи семейного бюджета: ровно двое, id:Имя через запятую
USERS=vlad:Влад,masha:Маша
# Пароли: PASSWORD_ + id в верхнем регистре
PASSWORD_VLAD=
PASSWORD_MASHA=
# Любая длинная случайная строка, например: openssl rand -hex 32
SESSION_SECRET=
# Необязательно: кто переносит данные из старого формата (по умолчанию первый из USERS)
# MIGRATION_OWNER=vlad

# Upstash Redis. При подключении через Vercel Marketplace переменные
# KV_REST_API_URL и KV_REST_API_TOKEN подставятся сами.
KV_REST_API_URL=
KV_REST_API_TOKEN=
