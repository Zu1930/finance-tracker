# Пользователи семейного бюджета: ровно двое, id:Имя через запятую
USERS=vlad:Влад,masha:Маша
# Пароли: PASSWORD_ + id в верхнем регистре
PASSWORD_VLAD=
PASSWORD_MASHA=
# Любая длинная случайная строка, например: openssl rand -hex 32
SESSION_SECRET=
# Необязательно: кто переносит данные из старого формата (по умолчанию первый из USERS)
# MIGRATION_OWNER=vlad

# Upstash Redis. При подключении через Vercel Marketplace переменные
# KV_REST_API_URL и KV_REST_API_TOKEN подставятся сами.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Push-уведомления (необязательно; без ключей уведомления просто выключены).
# Ключи: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для push-сервисов
VAPID_SUBJECT=mailto:you@example.com
# Секрет ежедневного cron (/api/cron/daily). Vercel передаёт его сам, если задан: openssl rand -hex 32
CRON_SECRET=
# Часовой пояс напоминаний (по умолчанию Europe/Belgrade)
# APP_TZ=Europe/Belgrade
